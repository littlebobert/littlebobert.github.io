        <item>
            <title>0.6.7</title>
            <pubDate>Sat, 31 Oct 2026 15:10:30 +0900</pubDate>
            <link>https://kehai.jp/</link>
            <sparkle:version>118</sparkle:version>
            <sparkle:shortVersionString>0.6.7</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description sparkle:format="markdown"><![CDATA[- File search no longer sets off macOS's folder-access prompts on your first search. Desktop, Documents and Downloads are now opt-in: Kehai asks with one line in the Files section, and you can change your choice in Settings.
- Fixed apps in the app strip that wouldn't open, such as Safari failing with "target process unavailable".
]]></description>
            <enclosure url="https://github.com/littlebobert/kehai/releases/download/0.6.7/Kehai-0.6.7-mac.zip" length="3172071" type="application/octet-stream" sparkle:edSignature="MlozHSs5Dduoqfft6dQ9msNqbsooNfC398tG1cHjIuAxQzN+aheMnWpovDZHjioC0saD3zCTKkmN1dmO6K8sDQ=="/>
        </item>
        <item>
            <title>0.6.6</title>
            <pubDate>Fri, 30 Oct 2026 15:20:39 +0900</pubDate>
            <link>https://kehai.jp/</link>
            <sparkle:version>117</sparkle:version>
            <sparkle:shortVersionString>0.6.6</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description sparkle:format="markdown"><![CDATA[- Searching in Kehai mini finds apps that ship inside other apps, like Xcode's Device Hub and Instruments, and menu-bar apps like Tailscale.
- A menu-bar app that opens a regular window, like Tailscale, now appears in the app strip while it's running as a normal app.
- The hot zone responds faster, and stays responsive when another app is busy, such as Xcode during a build.
]]></description>
            <enclosure url="https://github.com/littlebobert/kehai/releases/download/0.6.6/Kehai-0.6.6-mac.zip" length="3154110" type="application/octet-stream" sparkle:edSignature="88H0ws6V340x1yK0xaL/e+n3fcKHP9/8mhil0+7IjjRZa+MiiT1lqkJsUxJ6jRXGLR6Ei8I4pNacW8l5Z+AtBA=="/>
        </item>
        <item>
            <title>0.6.5</title>
            <pubDate>Thu, 29 Oct 2026 16:06:03 +0900</pubDate>
            <link>https://kehai.jp/</link>
            <sparkle:version>116</sparkle:version>
            <sparkle:shortVersionString>0.6.5</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description sparkle:format="markdown"><![CDATA[- Kehai mini no longer shows the same app twice in the app strip when that app has more than one process running.
- Searching for an app by name lists that app ahead of apps that only mention it in a window title, even when it isn't running yet.
]]></description>
            <enclosure url="https://github.com/littlebobert/kehai/releases/download/0.6.5/Kehai-0.6.5-mac.zip" length="3146904" type="application/octet-stream" sparkle:edSignature="gkouBPeMO+JWyQyFa9WWyN0rl9tbe5aO4BcOrq5Hijzj0pm31pJW3Pq2Z6ftweSJ44nKOLw3Rqg0Iat9mgG5Dg=="/>
